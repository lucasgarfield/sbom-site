index d7dcc9bfd..c5d22c558 100644
--- a/cmd/image-builder/sbom_image.go
+++ b/cmd/image-builder/sbom_image.go
@@ -38,6 +38,8 @@ func imageRootPackage(img *imagefilter.Result, basename string) map[string]any {
 		"packageFileName":  basename + filepath.Ext(img.ImgType.Filename()),
 		"downloadLocation": "NOASSERTION",
 		"supplier":         "NOASSERTION",
+		"licenseConcluded": "NOASSERTION",
+		"licenseDeclared":  "NOASSERTION",
 		"filesAnalyzed":    false,
 		"externalRefs": []map[string]string{{
 			"referenceCategory": "PACKAGE-MANAGER",
