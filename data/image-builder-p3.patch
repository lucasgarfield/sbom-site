From 63bbc2e7053cd51716528a803dfaf3088566c0eb Mon Sep 17 00:00:00 2001
From: Lucas Garfield <lucas@local>
Date: Wed, 14 Oct 2026 22:13:12 +0300
Subject: [PATCH 1/3] image-builder: list image-builder as an SBOM creator

The image SBOM's creationInfo.creators only named osbuild, which writes
the SPDX document during depsolving. image-builder is the tool the user
runs and it post-processes that document (image root package, image
checksum), so add "Tool: image-builder-<version>" next to osbuild.

The version is the one image-builder already reports in
"image-builder version" (main.version, set at build time by make or
the RPM spec); no new option is needed.
---
 cmd/image-builder/sbom_image.go      | 28 ++++++++++++++++++++++++++++
 cmd/image-builder/sbom_image_test.go | 16 +++++++++++++++-
 2 files changed, 43 insertions(+), 1 deletion(-)

diff --git a/cmd/image-builder/sbom_image.go b/cmd/image-builder/sbom_image.go
index fded51d43..d7dcc9bfd 100644
--- a/cmd/image-builder/sbom_image.go
+++ b/cmd/image-builder/sbom_image.go
@@ -80,9 +80,37 @@ func addImageRoot(content io.Reader, root map[string]any) ([]byte, error) {
 	if doc["relationships"], err = json.Marshal(newRels); err != nil {
 		return nil, err
 	}
+	if err := addCreator(doc, "Tool: image-builder-"+version); err != nil {
+		return nil, err
+	}
 	return json.Marshal(doc)
 }
 
+// addCreator lists image-builder next to the tool that wrote the document
+// (osbuild, which image-builder runs for depsolving).
+func addCreator(doc map[string]json.RawMessage, creator string) error {
+	var ci map[string]json.RawMessage
+	if raw, ok := doc["creationInfo"]; ok {
+		if err := json.Unmarshal(raw, &ci); err != nil {
+			return err
+		}
+	} else {
+		ci = map[string]json.RawMessage{}
+	}
+	var creators []string
+	if raw, ok := ci["creators"]; ok {
+		if err := json.Unmarshal(raw, &creators); err != nil {
+			return err
+		}
+	}
+	var err error
+	if ci["creators"], err = json.Marshal(append(creators, creator)); err != nil {
+		return err
+	}
+	doc["creationInfo"], err = json.Marshal(ci)
+	return err
+}
+
 // setImageRootSHA256 records the sha256 of the built image file on the
 // image root package of the SBOM at sbomPath.
 func setImageRootSHA256(sbomPath, imagePath string) error {
diff --git a/cmd/image-builder/sbom_image_test.go b/cmd/image-builder/sbom_image_test.go
index 1eff6c60b..9a791139c 100644
--- a/cmd/image-builder/sbom_image_test.go
+++ b/cmd/image-builder/sbom_image_test.go
@@ -13,7 +13,7 @@ import (
 	"github.com/stretchr/testify/require"
 )
 
-const testSPDX = `{"SPDXID":"SPDXRef-DOCUMENT","packages":[{"SPDXID":"SPDXRef-a","name":"a"}],
+const testSPDX = `{"SPDXID":"SPDXRef-DOCUMENT","creationInfo":{"creators":["Tool: osbuild-194"]},"packages":[{"SPDXID":"SPDXRef-a","name":"a"}],
 "relationships":[{"spdxElementId":"SPDXRef-DOCUMENT","relationshipType":"DESCRIBES","relatedSpdxElement":"SPDXRef-a"}]}`
 
 func TestImageRootManifestNoSHABuildSHA(t *testing.T) {
@@ -52,3 +52,17 @@ func TestImageRootManifestNoSHABuildSHA(t *testing.T) {
 	require.NoError(t, json.Unmarshal(doc, &m))
 	assert.Equal(t, m, b, "build SBOM differs from manifest SBOM only by the checksum")
 }
+
+func TestImageRootAddsImageBuilderCreator(t *testing.T) {
+	defer func(v string) { version = v }(version)
+	version = "88.0.0"
+	doc, err := addImageRoot(strings.NewReader(testSPDX), map[string]any{"SPDXID": imageRootSPDXID})
+	require.NoError(t, err)
+	var d struct {
+		CreationInfo struct {
+			Creators []string `json:"creators"`
+		} `json:"creationInfo"`
+	}
+	require.NoError(t, json.Unmarshal(doc, &d))
+	assert.Equal(t, []string{"Tool: osbuild-194", "Tool: image-builder-88.0.0"}, d.CreationInfo.Creators)
+}
