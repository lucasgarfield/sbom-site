From 26d538f5c6eedf63e944c3c4829322d988530039 Mon Sep 17 00:00:00 2001
From: sbom prototype <proto@local>
Date: Mon, 12 Oct 2026 22:29:41 +0300
Subject: [PATCH 2/3] oci-artifact: --fold-content-root

image-builder's content SBOM describes one logical OPERATING_SYSTEM root.
Nesting it under the artifact package would give two packages for the
same disk image, and the inner one may have no checksum.

With --fold-content-root, a single described content root is folded into
the artifact package:
- its purl/CPE references are added to the artifact,
- its version and primaryPackagePurpose are inherited if unset,
- its relationships are re-pointed to the artifact,
- the root package itself is dropped.
---
 src/mobster/cli.py                       |  7 ++++
 src/mobster/cmd/generate/oci_artifact.py | 51 +++++++++++++++++++++++-
 2 files changed, 56 insertions(+), 2 deletions(-)

diff --git a/src/mobster/cli.py b/src/mobster/cli.py
index f91f669..dd30160 100644
--- a/src/mobster/cli.py
+++ b/src/mobster/cli.py
@@ -395,6 +395,13 @@ def generate_oci_artifact_parser(subparsers: Any) -> None:
         help="SPDX primaryPackagePurpose to set on the artifact packages "
         "(e.g. FILE for a disk image file).",
     )
+    oci_artifact_parser.add_argument(
+        "--fold-content-root",
+        action="store_true",
+        help="Fold the single root described by the --from-sbom content SBOM "
+        "(e.g. osbuild's logical OS package) into the artifact package instead "
+        "of nesting it, so every package carries a checksum.",
+    )
     oci_artifact_parser.set_defaults(func=oci_artifact.GenerateOciArtifactCommand)
 
 
diff --git a/src/mobster/cmd/generate/oci_artifact.py b/src/mobster/cmd/generate/oci_artifact.py
index 9126f43..c58e4da 100644
--- a/src/mobster/cmd/generate/oci_artifact.py
+++ b/src/mobster/cmd/generate/oci_artifact.py
@@ -162,13 +162,21 @@ class GenerateOciArtifactCommand(GenerateCommandWithOutputTypeSelector):
