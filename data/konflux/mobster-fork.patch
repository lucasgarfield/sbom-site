Date: Mon, 12 Oct 2026 21:51:52 +0300
Subject: [PATCH 1/3] generate oci-artifact: merge a content SBOM (--from-sbom)
 and set --artifact-purpose

Disk images (qcow2, raw, ISO) pushed with oci-copy have no container
image SBOM. Their content SBOM comes from the image build (osbuild /
image-builder). This adds:

--from-sbom PATH (repeatable)
    Merge an SPDX 2.3 content SBOM into the oci-artifact SBOM. Every
    element DESCRIBED by the content SBOM is CONTAINED by the artifact
    package, and packages, relationships, extracted licenses and
    creators are carried over.

--artifact-purpose PURPOSE
    Set primaryPackagePurpose on the artifact package (for example
    OPERATING-SYSTEM for a disk image).
---
 src/mobster/cli.py                       | 22 +++++++
 src/mobster/cmd/generate/oci_artifact.py | 83 ++++++++++++++++++++++++
 2 files changed, 105 insertions(+)

diff --git a/src/mobster/cli.py b/src/mobster/cli.py
index 73132c5..f91f669 100644
--- a/src/mobster/cli.py
+++ b/src/mobster/cli.py
@@ -373,6 +373,28 @@ def generate_oci_artifact_parser(subparsers: Any) -> None:
         help="Type of SBOM to generate (default: cyclonedx)",
     )
 
+    oci_artifact_parser.add_argument(
+        "--from-sbom",
+        type=Path,
+        action="append",
+        help="Path to an SPDX content SBOM describing the (single) artifact, e.g. "
+        "the image SBOM produced by osbuild/image-builder for a disk image. "
+        "Can be specified multiple times. SPDX only.",
+    )
+    oci_artifact_parser.add_argument(
+        "--artifact-purpose",
+        choices=[
+            "OPERATING-SYSTEM",
+            "FILE",
+            "ARCHIVE",
+            "FIRMWARE",
+            "INSTALL",
+            "DEVICE",
+            "OTHER",
+        ],
+        help="SPDX primaryPackagePurpose to set on the artifact packages "
+        "(e.g. FILE for a disk image file).",
+    )
     oci_artifact_parser.set_defaults(func=oci_artifact.GenerateOciArtifactCommand)
 
 
diff --git a/src/mobster/cmd/generate/oci_artifact.py b/src/mobster/cmd/generate/oci_artifact.py
index 142f6a5..9126f43 100644
--- a/src/mobster/cmd/generate/oci_artifact.py
+++ b/src/mobster/cmd/generate/oci_artifact.py
