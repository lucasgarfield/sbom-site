         """
         Generate an SBOM document for oci artifact.
@@ -54,6 +74,8 @@ class GenerateOciArtifactCommand(GenerateCommandWithOutputTypeSelector):
             based on the command line arguments.
         """
         if self.cli_args.sbom_type == "cyclonedx":
