diff --git a/pkg/depsolvednf/trace.go b/pkg/depsolvednf/trace.go
new file mode 100644
index 000000000..5f94a8538
--- /dev/null
+++ b/pkg/depsolvednf/trace.go
@@ -0,0 +1,269 @@
+package depsolvednf
+
+// Developer-only instrumentation of the osbuild-depsolve-dnf round trip.
+//
+// Set IMAGE_BUILDER_DEPSOLVE_TRACE=<file> to append one JSON line per
+// depsolver call (depsolve, dump, search) with per-stage timings, payload
+// sizes, resource usage of the depsolver process and the field coverage of
+// the returned packages. Set IMAGE_BUILDER_DEPSOLVE_CAPTURE=<dir> to also
+// save the raw request and response bytes of every call (for replaying them
+// in benchmarks).
+//
+// When neither variable is set, all helpers here are no-ops. Tracing
+// serializes depsolver calls (it is not meant for concurrent production use).
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"runtime"
+	"sync"
+	"syscall"
+	"time"
+
+	"github.com/osbuild/image-builder/pkg/rpmmd"
+)
+
+const (
+	traceEnv   = "IMAGE_BUILDER_DEPSOLVE_TRACE"
+	captureEnv = "IMAGE_BUILDER_DEPSOLVE_CAPTURE"
+)
+
+// callTrace holds the measurements of one depsolver call. All durations are
+// in nanoseconds.
+type callTrace struct {
+	Command         string `json:"command"`
+	PackageMetadata string `json:"package_metadata"`
+	Seq             int    `json:"seq"`
+
+	RequestBytes  int `json:"request_bytes"`
+	ResponseBytes int `json:"response_bytes"`
+
+	// Go: building and marshalling the request
+	MarshalRequestNs int64 `json:"marshal_request_ns"`
+	// Go: from cmd.Start() until cmd.Wait() returned (the whole Python process)
+	ProcessNs int64 `json:"process_ns"`
+	// Go: time from cmd.Start() until the first and last stdout byte arrived
+	FirstByteNs int64 `json:"first_byte_ns"`
+	LastByteNs  int64 `json:"last_byte_ns"`
+	// Go: json.Unmarshal() of the response into the v2 wire structs
+	UnmarshalNs int64 `json:"unmarshal_ns"`
+	// Go: conversion of the v2 wire structs into rpmmd types
+	ConvertNs int64 `json:"convert_ns"`
+	// Go: everything after the process exited (cache touch, parse, RHSM, SBOM doc)
+	PostNs int64 `json:"post_ns"`
+	// Go: sbom.NewDocument() (depsolve only, when an SBOM was requested)
+	SBOMDocNs int64 `json:"sbom_doc_ns"`
+	// Go: the whole Solver method
+	TotalNs int64 `json:"total_ns"`
+
+	// Python process resource usage
+	ChildMaxRSSKiB int64 `json:"child_maxrss_kib"`
+	ChildUserNs    int64 `json:"child_user_ns"`
+	ChildSysNs     int64 `json:"child_sys_ns"`
+	// Go process after the call
+	SelfMaxRSSKiB  int64  `json:"self_maxrss_kib"`
+	GoHeapAlloc    uint64 `json:"go_heap_alloc"`
+	GoTotalAlloc   uint64 `json:"go_total_alloc_delta"`
+	goTotalAlloc0  uint64
+	start          time.Time
+	SBOMBytes      int            `json:"sbom_bytes"`
+	Packages       int            `json:"packages"`
+	Transactions   []int          `json:"transactions,omitempty"`
+	RelDeps        int            `json:"reldeps"`
+	Files          int            `json:"files"`
+	FieldCoverage  map[string]int `json:"field_coverage"`
+	CaptureRequest string         `json:"capture_request,omitempty"`
+}
+
+var (
+	traceMu    sync.Mutex
+	traceSeq   int
+	traceFile  = os.Getenv(traceEnv)
+	captureDir = os.Getenv(captureEnv)
+	// activeTrace is only non-nil between beginTrace() and finish()
+	activeTrace *callTrace
+)
+
+func tracingEnabled() bool {
+	return traceFile != "" || captureDir != ""
+}
+
+// beginTrace starts tracing a depsolver call; returns nil if disabled.
+func beginTrace(command string, level PackageMetadata) *callTrace {
+	if !tracingEnabled() {
+		return nil
+	}
+	traceMu.Lock()
+	traceSeq++
+	var ms runtime.MemStats
+	runtime.ReadMemStats(&ms)
+	if level == PackageMetadataDefault {
+		level = PackageMetadataFull
+	}
+	t := &callTrace{Command: command, PackageMetadata: string(level), Seq: traceSeq, start: time.Now(), goTotalAlloc0: ms.TotalAlloc}
+	activeTrace = t
+	return t
+}
+
+// traceStage returns a function that adds the elapsed time to *field of the
+// active trace. It is a no-op if tracing is disabled.
+func traceStage(field func(*callTrace) *int64) func() {
+	t := activeTrace
+	if t == nil {
+		return func() {}
+	}
+	start := time.Now()
+	return func() { *field(t) += time.Since(start).Nanoseconds() }
+}
+
+func (t *callTrace) setRequest(req []byte, marshal time.Duration) {
+	if t == nil {
+		return
+	}
+	t.RequestBytes = len(req)
+	t.MarshalRequestNs = marshal.Nanoseconds()
+	if captureDir != "" {
+		name := filepath.Join(captureDir, fmt.Sprintf("%d-%d-%s-%s.request.json", os.Getpid(), t.Seq, t.Command, t.PackageMetadata))
+		if err := os.WriteFile(name, req, 0o644); err == nil {
+			t.CaptureRequest = name
+		}
+	}
+}
+
+func (t *callTrace) setProcess(out []byte, ps *os.ProcessState, procDur time.Duration, w *timingWriter) {
+	if t == nil {
+		return
+	}
+	t.ResponseBytes = len(out)
+	t.ProcessNs = procDur.Nanoseconds()
+	if w != nil && !w.first.IsZero() {
+		t.FirstByteNs = w.first.Sub(w.start).Nanoseconds()
+		t.LastByteNs = w.last.Sub(w.start).Nanoseconds()
+	}
+	if ps != nil {
+		if ru, ok := ps.SysUsage().(*syscall.Rusage); ok {
+			t.ChildMaxRSSKiB = ru.Maxrss
+			t.ChildUserNs = time.Duration(ru.Utime.Nano()).Nanoseconds()
+			t.ChildSysNs = time.Duration(ru.Stime.Nano()).Nanoseconds()
+		}
+	}
+	if captureDir != "" {
+		name := filepath.Join(captureDir, fmt.Sprintf("%d-%d-%s-%s.response.json", os.Getpid(), t.Seq, t.Command, t.PackageMetadata))
+		_ = os.WriteFile(name, out, 0o644)
+	}
+}
+
+// finish computes the summary statistics (outside of the timed stages) and
+// appends the record to the trace file.
+func (t *callTrace) finish(transactions []rpmmd.PackageList, sbomBytes int) {
+	if t == nil {
+		return
+	}
+	defer traceMu.Unlock()
+	activeTrace = nil
+	t.TotalNs = time.Since(t.start).Nanoseconds()
+
+	var ms runtime.MemStats
+	runtime.ReadMemStats(&ms)
+	t.GoHeapAlloc = ms.HeapAlloc
+	t.GoTotalAlloc = ms.TotalAlloc - t.goTotalAlloc0
+	var ru syscall.Rusage
+	if err := syscall.Getrusage(syscall.RUSAGE_SELF, &ru); err == nil {
+		t.SelfMaxRSSKiB = ru.Maxrss
+	}
+	t.SBOMBytes = sbomBytes
+
+	t.FieldCoverage = map[string]int{}
+	cov := func(name string, ok bool) {
+		if ok {
+			t.FieldCoverage[name]++
+		}
+	}
+	for _, pl := range transactions {
+		t.Transactions = append(t.Transactions, len(pl))
+		for i := range pl {
+			p := &pl[i]
+			t.Packages++
+			cov("name", p.Name != "")
+			cov("version", p.Version != "")
+			cov("release", p.Release != "")
+			cov("arch", p.Arch != "")
+			cov("epoch_nonzero", p.Epoch != 0)
+			cov("summary", p.Summary != "")
+			cov("description", p.Description != "")
+			cov("license", p.License != "")
+			cov("vendor", p.Vendor != "")
+			cov("packager", p.Packager != "")
+			cov("url", p.URL != "")
+			cov("group", p.Group != "")
+			cov("source_rpm", p.SourceRpm != "")
+			cov("build_time", !p.BuildTime.IsZero())
+			cov("download_size", p.DownloadSize != 0)
+			cov("install_size", p.InstallSize != 0)
+			cov("checksum", p.Checksum.Value != "")
+			cov("header_checksum", p.HeaderChecksum.Value != "")
+			cov("repo_id", p.RepoID != "")
+			cov("location", p.Location != "")
+			cov("remote_locations", len(p.RemoteLocations) > 0)
+			cov("reason", p.Reason != "")
+			cov("provides", len(p.Provides) > 0)
+			cov("requires", len(p.Requires) > 0)
+			cov("requires_pre", len(p.RequiresPre) > 0)
+			cov("regular_requires", len(p.RegularRequires) > 0)
+			cov("conflicts", len(p.Conflicts) > 0)
+			cov("obsoletes", len(p.Obsoletes) > 0)
+			cov("recommends", len(p.Recommends) > 0)
+			cov("suggests", len(p.Suggests) > 0)
+			cov("supplements", len(p.Supplements) > 0)
+			cov("enhances", len(p.Enhances) > 0)
+			cov("files", len(p.Files) > 0)
+			t.RelDeps += len(p.Provides) + len(p.Requires) + len(p.RequiresPre) + len(p.RegularRequires) +
+				len(p.Conflicts) + len(p.Obsoletes) + len(p.Recommends) + len(p.Suggests) +
+				len(p.Supplements) + len(p.Enhances)
+			t.Files += len(p.Files)
+		}
+	}
+
+	if traceFile == "" {
+		return
+	}
+	line, err := json.Marshal(t)
+	if err != nil {
+		return
+	}
+	f, err := os.OpenFile(traceFile, os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0o644)
+	if err != nil {
+		return
+	}
+	defer f.Close()
+	_, _ = f.Write(append(line, '\n'))
+}
+
+// abort releases the trace lock without writing a record (error paths).
+func (t *callTrace) abort() {
+	if t == nil {
+		return
+	}
+	activeTrace = nil
+	traceMu.Unlock()
+}
+
+// timingWriter records when the first and the last chunk of the depsolver
+// output arrived.
+type timingWriter struct {
+	w     interface{ Write([]byte) (int, error) }
+	start time.Time
+	first time.Time
+	last  time.Time
+}
+
+func (tw *timingWriter) Write(p []byte) (int, error) {
+	now := time.Now()
+	if tw.first.IsZero() {
+		tw.first = now
+	}
+	tw.last = now
+	return tw.w.Write(p)
+}
diff --git a/pkg/depsolvednf/v2.go b/pkg/depsolvednf/v2.go
index d11344b14..145aaec52 100644
--- a/pkg/depsolvednf/v2.go
+++ b/pkg/depsolvednf/v2.go
@@ -328,9 +328,12 @@ func (h *v2Handler) makeSearchRequest(cfg *solverConfig, repos []rpmmd.RepoConfi
 
 func (h *v2Handler) parseDepsolveResult(output []byte) (*depsolveResultRaw, error) {
 	var result v2DepsolveResult
+	unmarshalDone := traceStage(func(t *callTrace) *int64 { return &t.UnmarshalNs })
 	if err := json.Unmarshal(output, &result); err != nil {
 		return nil, fmt.Errorf("decoding depsolve result failed: %w", err)
 	}
+	unmarshalDone()
