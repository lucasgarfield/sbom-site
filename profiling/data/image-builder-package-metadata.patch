From 58760d43de2a765f595b2ab32684e98ebcd34caa Mon Sep 17 00:00:00 2001
From: "Lucas Garfield (depsolve-perf prototype)" <proto@local>
Date: Fri, 16 Oct 2026 16:41:20 +0300
Subject: [PATCH 4/4] depsolvednf: add benchmarks for parsing captured V2
 responses

BenchmarkV2ParseUnmarshal measures json.Unmarshal of a depsolver response
into the v2 wire structs, BenchmarkV2ParseFull the whole parse including
the conversion into rpmmd types. Both run against real responses
captured with IMAGE_BUILDER_DEPSOLVE_CAPTURE and selected with
DEPSOLVE_BENCH_FILES (a glob); they are skipped when it is not set.
---
 pkg/depsolvednf/v2_bench_test.go | 97 ++++++++++++++++++++++++++++++++
 1 file changed, 97 insertions(+)
 create mode 100644 pkg/depsolvednf/v2_bench_test.go

diff --git a/pkg/depsolvednf/v2_bench_test.go b/pkg/depsolvednf/v2_bench_test.go
new file mode 100644
index 000000000..2aef8bf91
--- /dev/null
+++ b/pkg/depsolvednf/v2_bench_test.go
@@ -0,0 +1,97 @@
+package depsolvednf
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"testing"
+)
+
+// Benchmarks for the Go side of the depsolver round trip, run against real
+// captured depsolver responses (see IMAGE_BUILDER_DEPSOLVE_CAPTURE):
+//
+//	DEPSOLVE_BENCH_FILES='/path/to/*.response.json' go test -run XXX -bench V2Parse ./pkg/depsolvednf/
+//
+// Files whose name contains "dump" or "search" are parsed as package list
+// responses, all others as depsolve responses. The benchmarks are skipped when
+// DEPSOLVE_BENCH_FILES is not set.
+
+func benchFiles(b *testing.B) []string {
+	pattern := os.Getenv("DEPSOLVE_BENCH_FILES")
+	if pattern == "" {
+		b.Skip("DEPSOLVE_BENCH_FILES not set")
+	}
+	var files []string
+	for _, p := range strings.Fields(pattern) {
+		m, err := filepath.Glob(p)
+		if err != nil {
+			b.Fatal(err)
+		}
+		files = append(files, m...)
+	}
+	sort.Strings(files)
+	if len(files) == 0 {
+		b.Skipf("no files match %q", pattern)
+	}
+	return files
+}
+
+func isPackageList(name string) bool {
+	return strings.Contains(name, "dump") || strings.Contains(name, "search")
+}
+
+// BenchmarkV2ParseUnmarshal measures only json.Unmarshal into the v2 wire structs.
+func BenchmarkV2ParseUnmarshal(b *testing.B) {
+	for _, f := range benchFiles(b) {
+		data, err := os.ReadFile(f)
+		if err != nil {
+			b.Fatal(err)
+		}
+		b.Run(filepath.Base(f), func(b *testing.B) {
+			b.SetBytes(int64(len(data)))
+			b.ReportAllocs()
+			for b.Loop() {
+				if isPackageList(f) {
+					var r v2PackageListResult
+					if err := json.Unmarshal(data, &r); err != nil {
+						b.Fatal(err)
+					}
+				} else {
+					var r v2DepsolveResult
+					if err := json.Unmarshal(data, &r); err != nil {
+						b.Fatal(err)
+					}
+				}
+			}
+		})
+	}
+}
+
+// BenchmarkV2ParseFull measures the whole response handling: json.Unmarshal
+// plus conversion into rpmmd types.
+func BenchmarkV2ParseFull(b *testing.B) {
+	h := newV2Handler()
+	for _, f := range benchFiles(b) {
+		data, err := os.ReadFile(f)
+		if err != nil {
+			b.Fatal(err)
+		}
+		b.Run(filepath.Base(f), func(b *testing.B) {
+			b.SetBytes(int64(len(data)))
+			b.ReportAllocs()
+			for b.Loop() {
+				if isPackageList(f) {
+					if _, err := h.parseDumpResult(data); err != nil {
+						b.Fatal(err)
+					}
+				} else {
+					if _, err := h.parseDepsolveResult(data); err != nil {
+						b.Fatal(err)
+					}
+				}
+			}
+		})
+	}
+}
-- 
