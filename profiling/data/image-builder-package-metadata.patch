 }
 
+// applyDepsolveExperimentalFlags applies developer-only depsolver options
+// from IMAGE_BUILDER_EXPERIMENTAL. They exist to measure the cost of moving
+// RPM package metadata from osbuild-depsolve-dnf into image-builder and are
+// not a supported interface:
+//
+//	depsolve-package-metadata=full|minimal  amount of package metadata returned
+//	depsolve-optional-metadata=filelists    extra repo metadata types ("+"-separated)
+//	depsolve-no-sbom                         do not ask the depsolver for an SBOM
+//	                                         (only valid without --with-sbom)
+func applyDepsolveExperimentalFlags(solver *depsolvednf.Solver) error {
+	if v := experimentalflags.String("depsolve-package-metadata"); v != "" {
+		lvl, err := depsolvednf.ParsePackageMetadata(v)
+		if err != nil {
+			return fmt.Errorf("IMAGE_BUILDER_EXPERIMENTAL: %w", err)
+		}
+		solver.SetPackageMetadata(lvl)
+	}
+	if v := experimentalflags.String("depsolve-optional-metadata"); v != "" {
+		solver.AddOptionalMetadata(strings.Split(v, "+")...)
+	}
+	if experimentalflags.Bool("depsolve-no-sbom") {
+		solver.SetSBOMType(sbom.StandardTypeNone)
+	}
+	return nil
+}
+
 type (
 	DepsolveFunc func(solver *depsolvednf.Solver, cacheDir string, depsolveWarningsOutput io.Writer, packageSets map[string][]rpmmd.PackageSet, d distro.Distro, arch string) (map[string]depsolvednf.DepsolveResult, error)
 
