+package depsolvednf
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/osbuild/image-builder/pkg/rpmmd"
+	"github.com/osbuild/image-builder/pkg/sbom"
+)
+
+func TestParsePackageMetadata(t *testing.T) {
+	for _, s := range []string{"", "full", "minimal"} {
+		lvl, err := ParsePackageMetadata(s)
+		require.NoError(t, err)
+		assert.Equal(t, PackageMetadata(s), lvl)
+	}
+	_, err := ParsePackageMetadata("everything")
+	assert.Error(t, err)
+}
+
+func TestV2RequestsCarryPackageMetadataAndOptionalMetadata(t *testing.T) {
+	repo := rpmmd.RepoConfig{Name: "baseos", BaseURLs: []string{"https://example.org/baseos"}}
+	pkgSets := []rpmmd.PackageSet{{Include: []string{"bash"}, Repositories: []rpmmd.RepoConfig{repo}}}
+	h := newV2Handler()
+
+	type args struct {
+		PackageMetadata  string   `json:"package_metadata"`
+		OptionalMetadata []string `json:"optional-metadata"`
+	}
+	decode := func(raw []byte) args {
+		var req struct {
+			Arguments args `json:"arguments"`
+		}
+		require.NoError(t, json.Unmarshal(raw, &req))
+		return req.Arguments
+	}
+
+	t.Run("default omits the field", func(t *testing.T) {
+		cfg := &solverConfig{modulePlatformID: "platform:f44", arch: "x86_64", releaseVer: "44", cacheDir: "/c"}
+		raw, err := h.makeDepsolveRequest(cfg, pkgSets, sbom.StandardTypeNone)
+		require.NoError(t, err)
+		assert.NotContains(t, string(raw), "package_metadata")
+		assert.NotContains(t, string(raw), "optional-metadata")
+	})
+
+	t.Run("minimal and filelists on all commands", func(t *testing.T) {
+		cfg := &solverConfig{
+			modulePlatformID: "platform:el9", arch: "x86_64", releaseVer: "9", cacheDir: "/c",
+			packageMetadata:       PackageMetadataMinimal,
+			extraOptionalMetadata: []string{"filelists", "other"},
+		}
+		raw, err := h.makeDepsolveRequest(cfg, pkgSets, sbom.StandardTypeNone)
+		require.NoError(t, err)
+		a := decode(raw)
+		assert.Equal(t, "minimal", a.PackageMetadata)
+		// el9 already loads filelists by default, it must not be duplicated
+		assert.Equal(t, []string{"filelists", "other"}, a.OptionalMetadata)
+
+		raw, err = h.makeDumpRequest(cfg, []rpmmd.RepoConfig{repo})
+		require.NoError(t, err)
+		a = decode(raw)
+		assert.Equal(t, "minimal", a.PackageMetadata)
+		assert.Equal(t, []string{"filelists", "other"}, a.OptionalMetadata)
+
+		raw, err = h.makeSearchRequest(cfg, []rpmmd.RepoConfig{repo}, []string{"bash"})
+		require.NoError(t, err)
+		a = decode(raw)
+		assert.Equal(t, "minimal", a.PackageMetadata)
+	})
+}
+
+// A "minimal" response only carries the manifest fields; everything else
+// must come out as zero values without errors.
+func TestV2ParseMinimalDepsolveResult(t *testing.T) {
+	out := []byte(`{"solver": "dnf5", "transactions": [[{
+		"name": "bash", "epoch": 0, "version": "5.2", "release": "1.fc44", "arch": "x86_64",
+		"repo_id": "r1", "location": "Packages/b/bash.rpm",
+		"remote_locations": ["https://example.org/Packages/b/bash.rpm"],
+		"checksum": {"algorithm": "sha256", "value": "abcd"}}]],
+		"repos": {"r1": {"id": "r1", "name": "r1", "baseurl": ["https://example.org"]}},
+		"modules": {}}`)
+	res, err := newV2Handler().parseDepsolveResult(out)
+	require.NoError(t, err)
+	require.Len(t, res.Transactions, 1)
+	require.Len(t, res.Transactions[0], 1)
+	p := res.Transactions[0][0]
+	assert.Equal(t, "bash", p.Name)
+	assert.Equal(t, "sha256:abcd", p.Checksum.String())
+	assert.Empty(t, p.License)
+	assert.Empty(t, p.Provides)
+	assert.True(t, p.BuildTime.IsZero())
+}
