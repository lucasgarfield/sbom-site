Subject: [PATCH 3/4] image-builder: add developer-only pprof hooks

IMAGE_BUILDER_CPUPROFILE=<file> writes a CPU profile of the whole run,
IMAGE_BUILDER_MEMPROFILE=<file> an allocation profile at exit. Used to
profile `image-builder manifest`; not a supported interface.
---
 cmd/image-builder/main.go    |  2 ++
 cmd/image-builder/profile.go | 41 ++++++++++++++++++++++++++++++++++++
 2 files changed, 43 insertions(+)
 create mode 100644 cmd/image-builder/profile.go

diff --git a/cmd/image-builder/main.go b/cmd/image-builder/main.go
index b057bb972..804cfd8ce 100644
--- a/cmd/image-builder/main.go
+++ b/cmd/image-builder/main.go
@@ -1022,7 +1022,9 @@ func main() {
 	if strings.HasSuffix(os.Args[0], "bootc-image-builder") {
 		err = bibRun()
 	} else {
+		stopProfiling := startProfiling()
 		err = run()
+		stopProfiling()
 	}
 	if err != nil {
 		log.Fatalf("error: %s\n", err)
diff --git a/cmd/image-builder/profile.go b/cmd/image-builder/profile.go
new file mode 100644
index 000000000..d18f8f94d
--- /dev/null
+++ b/cmd/image-builder/profile.go
@@ -0,0 +1,41 @@
+package main
+
+// Developer-only profiling hooks, enabled by environment variables:
+//
+//	IMAGE_BUILDER_CPUPROFILE=<file>   write a pprof CPU profile of the whole run
+//	IMAGE_BUILDER_MEMPROFILE=<file>   write a pprof heap (alloc) profile at exit
+//
+// They are used to profile `image-builder manifest`; they are not a
+// supported interface.
+
+import (
+	"os"
+	"runtime"
+	"runtime/pprof"
+)
+
+func startProfiling() (stop func()) {
+	stop = func() {}
+	if path := os.Getenv("IMAGE_BUILDER_MEMPROFILE"); path != "" {
+		runtime.MemProfileRate = 64 * 1024
+	}
+	var cpuFile *os.File
+	if path := os.Getenv("IMAGE_BUILDER_CPUPROFILE"); path != "" {
+		f, err := os.Create(path)
+		if err == nil && pprof.StartCPUProfile(f) == nil {
+			cpuFile = f
+		}
+	}
+	return func() {
+		if cpuFile != nil {
+			pprof.StopCPUProfile()
+			cpuFile.Close()
+		}
+		if path := os.Getenv("IMAGE_BUILDER_MEMPROFILE"); path != "" {
+			if f, err := os.Create(path); err == nil {
+				_ = pprof.Lookup("allocs").WriteTo(f, 0)
+				f.Close()
+			}
+		}
+	}
+}
-- 
