@@ -348,9 +349,38 @@ func DefaultDepsolve(solver *depsolvednf.Solver, cacheDir string, depsolveWarnin
 	// type. Once we have more types than Spdx of course
 	// we need to add a option to select the type.
 	solver.SetSBOMType(sbom.StandardTypeSpdx)
+	if err := applyDepsolveExperimentalFlags(solver); err != nil {
+		return nil, err
+	}
