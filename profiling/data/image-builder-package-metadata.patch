+	}
+}
+
+// depsolveOptionalMetadata returns the repository metadata types to load for
+// a depsolve request: the distro defaults plus any extra types requested with
+// Solver.AddOptionalMetadata().
+func depsolveOptionalMetadata(cfg *solverConfig) []string {
+	md := optionalMetadataForDistro(cfg.modulePlatformID)
+	for _, t := range cfg.extraOptionalMetadata {
+		if !slices.Contains(md, t) {
+			md = append(md, t)
+		}
 	}
+	return md
 }
 
 // hashRequest computes a SHA256 hash of the request raw data for caching.
@@ -264,6 +288,44 @@ func collectRepos(pkgSets []rpmmd.PackageSet) []rpmmd.RepoConfig {
 	return repos
 }
 
+// PackageMetadata selects how much RPM package metadata osbuild-depsolve-dnf
+// returns for every package in depsolve, dump and search responses.
+type PackageMetadata string
+
+const (
+	// PackageMetadataDefault leaves the choice to the depsolver (full).
+	PackageMetadataDefault PackageMetadata = ""
+	// PackageMetadataFull requests all package metadata the depsolver knows
+	// about (NEVRA, checksums, license, summary, description, vendor,
+	// packager, URL, source RPM, build time, sizes, reldeps, files, ...).
+	PackageMetadataFull PackageMetadata = "full"
+	// PackageMetadataMinimal requests only what is needed for a manifest:
+	// NEVRA, repo ID, location, remote locations and checksum.
+	PackageMetadataMinimal PackageMetadata = "minimal"
+)
+
+// ParsePackageMetadata parses a PackageMetadata level from a string.
+func ParsePackageMetadata(s string) (PackageMetadata, error) {
+	switch PackageMetadata(s) {
+	case PackageMetadataDefault, PackageMetadataFull, PackageMetadataMinimal:
+		return PackageMetadata(s), nil
+	}
+	return PackageMetadataDefault, fmt.Errorf("invalid package metadata level %q (must be %q or %q)", s, PackageMetadataFull, PackageMetadataMinimal)
+}
+
+// SetPackageMetadata sets how much package metadata the depsolver returns.
+func (s *Solver) SetPackageMetadata(level PackageMetadata) {
+	s.packageMetadata = level
+}
+
+// AddOptionalMetadata requests additional repository metadata types (e.g.
+// "filelists") to be loaded by the depsolver, on top of the distro defaults.
+// Loading "filelists" makes the depsolver return the file list of every
+// package.
+func (s *Solver) AddOptionalMetadata(types ...string) {
+	s.extraOptionalMetadata = append(s.extraOptionalMetadata, types...)
+}
+
 // Set the SBOM type to generate with the depsolve.
 func (s *Solver) SetSBOMType(sbomType sbom.StandardType) {
 	s.sbomType = sbomType
