+class PackageMetadata(Enum):
+    """
+    How much RPM package metadata the solver returns for every package.
+
+    FULL returns everything the solver model knows about a package (NEVRA,
+    checksums, header checksum, license, summary, description, vendor,
+    packager, URL, source RPM, build time, sizes, group, reason, all
+    reldeps and the file list, if file lists were loaded).
+
+    MINIMAL returns only what is needed to put the package into a manifest
+    (NEVRA, repo_id, location, remote_locations and checksum). The solver
+    does not even read the other fields from DNF in this mode.
+    """
+    FULL = "full"
+    MINIMAL = "minimal"
+
+    def __str__(self) -> str:
+        return self.value
+
